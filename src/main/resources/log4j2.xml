<?xml version="1.0" encoding="UTF-8"?>
<Configuration package="fr.sparks.travel" status="INFO">

	<Appenders>
		<File name="File" fileName="log/travel_log">
			<PatternLayout>
				<Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
			</PatternLayout>
		</File>
	</Appenders>

	<Loggers>
		<Root level="fatal">
			<AppenderRef ref="File" />
		</Root>
	</Loggers>
</Configuration>